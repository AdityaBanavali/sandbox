# Application Settings
APP_NAME="Cyber Defense Enclave Threat Detection"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="cyber-threat-detection-unidirectional-traffic-secret-key-change-in-production"

# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cyber_defense_db

# Asynchronous and Synchronous Database URLs
# For local development outside Docker (use 'db' host inside Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cyber_defense_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cyber_defense_db

# Redis Configuration (Celery broker & Pub/Sub channel)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AI Detection Engine Parameters
AI_MODEL_VERSION="v1.0.0-unidirectional-rf-xgb"
DETECTION_THRESHOLD=0.75
ENTROPY_THRESHOLD=6.5
